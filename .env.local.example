# Supabase project settings (Project Settings -> API in the Supabase dashboard).
# Copy this file to .env.local and fill in your project's values.
# Never put the service_role key in a NEXT_PUBLIC_* variable or in client code.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Secures /api/cron/agenda-reminders (see vercel.json). Set this in the
# Vercel project's environment variables — Vercel Cron then automatically
# sends it as "Authorization: Bearer <value>" on every scheduled call.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# Web Push (Fase 5). Set these in Vercel too, or push notifications silently
# no-op. Generate your own pair with: npx web-push generate-vapid-keys
# (never reuse the pair from an example/README — generate a fresh one).
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# E-mail (uitnodigingen, wachtwoord-reset). Vereist een geverifieerd domein
# bij Resend (resend.com) — zonder domein kun je alleen naar je eigen
# Resend-accountmail testen. EMAIL_FROM moet een adres op dat domein zijn.
RESEND_API_KEY=
EMAIL_FROM="VOC Ledenportaal <noreply@jouw-domein.nl>"

# Basis-URL van het portaal, gebruikt om links in uitgaande e-mails op te
# bouwen (bijv. de registratielink in de uitnodigingsmail). Geen trailing slash.
SITE_URL=http://localhost:3000

# Signing secret van de Resend-webhook naar /api/webhooks/resend (Resend
# dashboard -> Webhooks -> event "email.opened" aanzetten, endpoint-URL
# invullen, secret hiernaartoe kopiëren). Zonder deze variabele worden
# "geopende e-mails" nooit geteld in Statistieken > Notificaties, maar blijft
# de rest van de app gewoon werken.
RESEND_WEBHOOK_SECRET=

# Alleen server-side gebruikt, nooit in een NEXT_PUBLIC_*-variabele: nodig om
# via de Supabase Admin API een wachtwoord-reset-link te genereren zonder
# Supabase's eigen e-mail te versturen (Project Settings -> API -> service_role
# secret key). Geeft volledige toegang tot de database — nooit committen, nooit
# in clientcode.
SUPABASE_SERVICE_ROLE_KEY=
