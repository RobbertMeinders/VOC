# Supabase project settings (Project Settings -> API in the Supabase dashboard).
# Copy this file to .env.local and fill in your project's values.
# Never put the service_role key in a NEXT_PUBLIC_* variable or in client code.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used later (Fase 5) for Web Push. Generate with: npx web-push generate-vapid-keys
# VAPID_PRIVATE_KEY=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
